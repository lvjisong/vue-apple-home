# ============================================================
# .dockerignore —— Docker 构建时忽略的文件
# ------------------------------------------------------------
# 作用：构建镜像的时候，这些文件不复制到容器里，减小构建上下文体积
# 类似 .gitignore
# ============================================================

# 依赖目录（容器里会重新 npm install）
node_modules

# 打包输出（容器里会重新 build）
dist

# Git 相关
.git
.gitignore

# IDE 相关
.vscode
.idea
*.swp
*.swo

# 环境变量文件（敏感信息不打进镜像，运行时用 -e 传入）
.env
.env.*

# 日志
*.log
npm-debug.log*

# 系统文件
.DS_Store
Thumbs.db
