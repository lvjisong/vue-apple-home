# ============================================================
# .env.development —— 本地开发环境变量（npm run serve 自动加载）
# ------------------------------------------------------------
# 约定：
#   - 变量必须以 VUE_APP_ 开头，否则 webpack 不会注入到 process.env。
#   - 改了 env 必须重启 dev server（npm run serve）才生效。
#   - 后端地址走 vue.config.js 的 devServer.proxy 代理，不改这里。
# ============================================================
# 开发环境的图片域名
# 本地图片走 /images/...（public/images/ 下）
# 如需切回官网 CDN，改 VUE_APP_IMAGE_BASE 即可
VUE_APP_IMAGE_BASE=/images
# TODO-DEVELOPMENT: 开发环境的CDN域名（可改成自己的域名）
VUE_APP_SITE_URL=https://www.apple.com.cn
# TODO-DEVELOPMENT: 后端 API 前缀（配合 vue.config.js devServer.proxy 转发）
VUE_APP_BASE_API=/api
